# ---- Appwrite (server-side secret) ----
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_api_key

# ---- Appwrite resource IDs ----
APPWRITE_DATABASE_ID=event_db
APPWRITE_COLLECTION_EVENTS=events
APPWRITE_COLLECTION_CHECKINS=checkins
APPWRITE_COLLECTION_VISITS=visit_logs
APPWRITE_COLLECTION_CLICKS=click_logs
APPWRITE_BUCKET_PHOTOS=event-photos

# ---- Event ----
NEXT_PUBLIC_EVENT_SLUG=corsair-guma-2026

# ---- Admin & security ----
# ADMIN_KEY: quản lý — xem MỌI thứ
# STAFF_KEY: nhân sự — chỉ xem KPI + biểu đồ theo ngày, danh sách bị che
#            thông tin cá nhân (tên/SĐT/email/địa chỉ/giờ) và chỉ tìm được
#            theo mã tham gia. Để trống nếu không muốn dùng role staff.
ADMIN_KEY=change_me_long_random_string
STAFF_KEY=change_me_another_long_random_string
IDENTITY_SALT=change_me_random_string
